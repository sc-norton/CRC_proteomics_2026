# Lecture 09/01/26
# A vector is a ONE-DIMENSIONAL, HOMOGENEOUS data structure.
# Homogeneous means that every element of the vector has the same underlying type.
# 1.1 Creating Vectors ####
# c() means "combine" or "concatenate"
# it joings individual values into a vector
grand_slam_win <- c(16, 19, 20, 0, 0)
# It will print as a row, but it's stored as a column
grand_slam_win
# You can assign a vector and print it at the same time by wrapping the
# assignment in ( )
(grand_slam_win <- c(16, 19, 20, 0, 0))
# c() can also combine previously created vectors
first_players <- c(16, 19)
remaining_players <- c(20, 0, 0)
# if you assign to same name, it gets overwritten with new values
# Note: R is case sensitive
grand_slam_win <- c(first_players, remaining_players)
grand_slam_win
# Nested uses of c() ultimately produce a single vector.
grand_slam_win <- c(16, c(19, 20), c(0, 0))
grand_slam_win
# Character vectors are created in the same way.
players <- c(
"Novak Djokovic",
"Rafael Nadal",
"Roger Federer",
"Daniil Medvedev",
"Dominic Thiem"
)
players
# 1.2 Vector Type ####
# typeof() tells us the underlying type sotred by R.
typeof(grand_slam_win) # note: 'double' = 'numeric'
typeof(players)
# Important:
# R normally represents ordinary numbers as double, even when teh displayed
# number looks like an integer.
# * numbers take up more memory than integers i.e. 1.000000000 vs 1
typeof(1)
# To explicitly create an integer, append L.
typeof(1L)
# Thus we could create an integer vector as follows.
grand_slam_win_integer <- c(16L, 19L, 20L, 0L, 0L)
typeof(grand_slam_win_integer)
# or you can convert an object of one type to another with a function:
grand_slam_win_integer <- as.integer(grand_slam_win)
grand_slam_win <- as.numeric(grand_slam_win_integer)
grand_slam_win_chr <- as.character(grand_slam_win_integer)
sum(grand_slam_win_chr) # Error due to wrong 'type' of argument
grand_slam_win[grand_slam_win > 10]
# Corresponding player names:
players[grand_slam_win > 10]
attr(grand_slam_win, "date") <- "09-30-2019"
attr(grand_slam_win, "type") <- "Men, Singles"
# Print the object, including attributes.
grand_slam_win
Sys.Date()
attr(grand_slam_win, "date") <- Sys.Date()
attr(grand_slam_win, "type") <- "Men, Singles"
# Print the object, including attributes.
grand_slam_win
grand_slam_win <- c(
"Novak Djokovic"  = 16,
"Rafael Nadal"    = 19,
"Roger Federer"   = 20,
"Daniil Medvedev" = 0,
"Dominic Thiem"   = 0
)
grand_slam_win
# names() returns the labels
names(grand_slam_win)
# Named vectors can be subset using names instead of numerical positions.
grand_slam_win["Novak Djokovic"]
# names() returns the labels
players_from_labels <- names(grand_slam_win)
vec_letters <- letters[1:5]
names(grand_slam_win) <- vec_letters
names(grand_slam_win)
names(grand_slam_win) <- c(vec_letters, "extra")
paste(vec_letters, players_from_labels)
names(grand_slam_win) <- players_from_labels
grand_slam_win
# Named vectors can be subset using names instead of numerical positions.
grand_slam_win["Novak Djokovic"]
grand_slam_win["Novak Djokovic", "Roger Federer"]
grand_slam_win[c("Novak Djokovic", "Roger Federer")]
# We can also add names after creating a vector:
x <- c(10, 20, 30)
names(x)
names(x) <- c("First", "Second", "Third")
x
# consider:
# "MM-DD-YYYY"
dates_as_characters <- c(
"03-21-2015",
"12-31-2011",
"06-27-2008",
"01-01-2012"
)
sort(dates_as_characters)
as.Date(dates_as_characters)
# --- Converting character strings to Date objects -------------------
players_dob <- as.Date(
c(
"22 May 1987",
"3 Jun 1986",
"8 Aug 1981",
"11 Feb 1996",
"3 Sep 1993"
),
format = "%d %b %Y"
)
players_dob
sort(players_dob)
